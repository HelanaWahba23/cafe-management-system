@using CafeManagement.Api.Components.Shared
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider StaticFiles
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <link rel="stylesheet" href="lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@Styles" />
    <HeadOutlet />
</head>
<body>
    <div id="app-content"><Routes /></div>
    <ReconnectStatus />
    <script src="js/order-session.js"></script>
    <script src="js/reconnect-status.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    private string Styles => StaticFiles.AddFileVersionToPath(string.Empty, "/css/site.css");
}
