@inherits LayoutComponentBase
<AuthorizeView Roles="Cashier" Context="cashier">
    <Authorized>
        <header class="border-bottom bg-dark text-white">
            <nav class="container d-flex flex-wrap align-items-center gap-3 py-3" aria-label="Cashier navigation">
                <span class="fw-bold">Cafe · Counter</span>
                <a class="text-white" href="/pos/orders">Orders</a>
                <a class="text-white" href="/pos/orders/new">New walk-in</a>
                <span class="ms-md-auto text-break">@cashier.User.Identity?.Name</span>
                <form method="post" action="/account/logout" data-enhance="false"><AntiforgeryToken /><button class="btn btn-outline-light">Sign out</button></form>
            </nav>
        </header>
        <main class="container py-4">@Body</main>
    </Authorized>
    <NotAuthorized><main class="container py-4"><h1>Cashier access required</h1><a href="/account/login?ReturnUrl=/pos/orders">Sign in</a></main></NotAuthorized>
</AuthorizeView>
