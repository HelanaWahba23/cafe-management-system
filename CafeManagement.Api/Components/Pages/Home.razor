@page "/"
@attribute [AllowAnonymous]
@layout PublicLayout

<PageTitle>Café | Food worth gathering for.</PageTitle>
<div class="cafe-home">
    <section class="cafe-hero" aria-labelledby="cafe-welcome">
        <img class="cafe-hero-image" src="/images/restaurant-hero.png" alt="Burgers, pizza, salad and lemonade on a restaurant table" width="1672" height="941" fetchpriority="high" />
        <div class="cafe-hero-shade"></div>
        <div class="cafe-hero-content">
            <p class="cafe-overline"><span aria-hidden="true"></span> Good food. Shared moments.</p>
            <h1 id="cafe-welcome">Good food.<br /><em>Great company.</em></h1>
            <p class="cafe-hero-description">Slow down, find your favorite, and make a little room for the good things.</p>
            <div class="cafe-hero-actions">
                <a class="btn cafe-light-button" href="@MenuLink" data-enhance-nav="false">Explore the menu <span aria-hidden="true">↗</span></a>
                <a class="cafe-hero-about" href="#about">A little about us <span aria-hidden="true">↓</span></a>
            </div>
        </div>
        <div class="cafe-hero-caption"><span aria-hidden="true">✦</span> A table worth gathering around.</div>
    </section>

    <section class="cafe-welcome-strip" aria-label="The Café experience">
        <div><span class="cafe-strip-number" aria-hidden="true">01</span><div><h2>Find your favorite</h2><p>A little something for every mood.</p></div></div>
        <div><span class="cafe-strip-number" aria-hidden="true">02</span><div><h2>Make it your moment</h2><p>Take a seat and enjoy the pause.</p></div></div>
        <div><span class="cafe-strip-number" aria-hidden="true">03</span><div><h2>Your favorites, your way</h2><p>Delivery, pickup, or at your table.</p></div></div>
    </section>

    <section id="about" class="cafe-about" aria-labelledby="cafe-about-title">
        <div class="cafe-about-photo"><img src="/images/restaurant-hero.png" alt="Restaurant dishes arranged on a warm wooden table" width="1672" height="941" loading="lazy" /><span>Small moments. Well spent.</span></div>
        <div class="cafe-about-copy">
            <p class="eyebrow">Hello, we're Café</p>
            <h2 id="cafe-about-title">Your table.<br /><em>Your kind of place.</em></h2>
            <p>For an easy lunch, a catch-up over dinner, or a meal to enjoy at home. Café brings your favorites together, with a little room for something new.</p>
            <p>Choose delivery with cash on arrival, collect your order, or scan your table QR to dine in. Track every step from your account or private order link.</p>
            <a href="@MenuLink" class="cafe-text-link" data-enhance-nav="false">Find something you'll love <span aria-hidden="true">↗</span></a>
        </div>
    </section>

    <section class="cafe-pickup-banner" aria-labelledby="cafe-pickup-title">
        <div><p class="cafe-overline">A little Café, wherever your day takes you</p><h2 id="cafe-pickup-title">Your next good moment starts here.</h2></div>
        <a href="@MenuLink" class="btn cafe-light-button" data-enhance-nav="false">Start your order <span aria-hidden="true">↗</span></a>
    </section>
</div>

@code { [SupplyParameterFromQuery(Name="table")] public Guid? TableCode {get;set;} private string MenuLink => TableCode.HasValue ? $"/menu/t/{TableCode:D}" : "/menu"; }
