@page "/menu/t/{PublicCode}"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout PublicLayout
@using CafeManagement.Api.Components.Shared
@using CafeManagement.Api.Application
@using CafeManagement.Api.Contracts
@inject PublicMenuService Menu

<PageTitle>Menu | Cafe Management</PageTitle>
<h1>Menu</h1>
@if (loading)
{
    <p role="status">Loading menu…</p>
}
else if (failure is not null)
{
    <div class="alert alert-danger" role="alert">@failure.Message</div>
}
else if (menu is not null)
{
    <p id="menu-table">Table: <strong>@menu.Table.Label</strong></p>
    @if (addError is not null)
    {
        <div class="alert alert-danger" role="alert">@addError</div>
    }
    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <MenuCatalog Categories="menu.Categories" Currency="@menu.Currency" OnAdd="AddProduct" />
        </div>
        <div class="col-12 col-lg-4">
            <CartPanel Cart="cart" OnChanged="CartChanged" />
        </div>
    </div>
}
<button type="button" class="btn btn-outline-secondary" disabled="@loading" @onclick="LoadAsync">@(failure?.Kind == OperationErrorKind.Unexpected ? "Retry loading menu" : "Reload menu")</button>

@code {
    [Parameter] public string? PublicCode { get; set; }
    private PublicMenuDetails? menu;
    private OperationError? failure;
    private bool loading = true;
    private int loadVersion;
    private readonly CartState cart = new();
    private string? addError;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        // A later table navigation must win if an earlier read finishes afterward.
        var version = ++loadVersion;
        loading = true;
        menu = null;
        failure = null;
        addError = null;
        var result = await Menu.GetAsync(PublicCode);
        if (version != loadVersion) return;
        menu = result.Value;
        failure = result.Error;
        if (menu is not null) cart.SetContext(CafeManagement.Api.Domain.OrderType.DineIn, menu.Table.PublicCode);
        loading = false;
    }

    private void AddProduct(int productId)
    {
        var product = menu?.Categories.SelectMany(category => category.Products)
            .SingleOrDefault(product => product.Id == productId);
        if (loading || product is null)
        {
            addError = "This product is not available in the current menu. Reload the menu.";
            return;
        }
        cart.TryAdd(product, out addError);
    }

    private void CartChanged() => addError = null;
}
