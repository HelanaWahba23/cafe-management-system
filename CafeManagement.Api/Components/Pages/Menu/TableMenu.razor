@page "/menu/t/{PublicCode}"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout PublicLayout
@using System.Globalization
@using CafeManagement.Api.Application
@using CafeManagement.Api.Contracts
@inject PublicMenuService Menu

<PageTitle>Menu | Cafe Management</PageTitle>
<h1>Menu</h1>
@if (loading)
{
    <p role="status">Loading menu…</p>
}
else if (failure is not null)
{
    <div class="alert alert-danger" role="alert">@failure.Message</div>
}
else if (menu is not null)
{
    <p id="menu-table">Table: <strong>@menu.Table.Label</strong></p>
    @if (menu.Categories.Length == 0 || menu.Categories.All(c => c.Products.Length == 0))
    {
        <p role="status">No available products are currently listed.</p>
    }
    @if (menu.Categories.Length > 0)
    {
        <nav aria-label="Menu categories" class="mb-4">
            <ul class="nav gap-2">
                @foreach (var category in menu.Categories)
                {
                    <li class="nav-item"><a class="btn btn-outline-primary" href="@($"/menu/t/{menu.Table.PublicCode:D}#category-{category.Id}")" data-enhance-nav="false">@category.Name</a></li>
                }
            </ul>
        </nav>
        @foreach (var category in menu.Categories)
        {
            <section class="card mb-3" aria-labelledby="@($"category-{category.Id}")">
                <div class="card-body">
                    <h2 id="@($"category-{category.Id}")" class="h4" tabindex="-1">@category.Name</h2>
                    @if (category.Products.Length == 0)
                    {
                        <p class="mb-0">No available products in this category.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var product in category.Products)
                            {
                                <li class="list-group-item px-0 d-flex flex-wrap justify-content-between gap-2">
                                    <span>@product.Name</span>
                                    <span class="fw-semibold text-nowrap">@menu.Currency @product.Price.ToString("F2", CultureInfo.InvariantCulture)</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        }
    }
}
<button type="button" class="btn btn-outline-secondary" disabled="@loading" @onclick="LoadAsync">@(failure?.Kind == OperationErrorKind.Unexpected ? "Retry loading menu" : "Reload menu")</button>

@code {
    [Parameter] public string? PublicCode { get; set; }
    private PublicMenuDetails? menu;
    private OperationError? failure;
    private bool loading = true;
    private int loadVersion;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        // A later table navigation must win if an earlier read finishes afterward.
        var version = ++loadVersion;
        loading = true;
        menu = null;
        failure = null;
        var result = await Menu.GetAsync(PublicCode);
        if (version != loadVersion) return;
        menu = result.Value;
        failure = result.Error;
        loading = false;
    }
}
