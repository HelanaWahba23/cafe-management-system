@page "/pos/orders/new"
@attribute [Authorize(Policy = "Cashier")]
@rendermode InteractiveServer
@layout PosLayout
@using System.Security.Cryptography
@using Microsoft.JSInterop
@implements IAsyncDisposable
@using CafeManagement.Api.Application
@using CafeManagement.Api.Contracts
@using Microsoft.AspNetCore.Components.Routing
@inject PosOrderService Pos
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>New walk-in | Cafe Counter</PageTitle>

<a href="/pos/orders">Back to orders</a><h1 class="my-3">New walk-in order</h1>
<p class="text-secondary">Choose table dine-in or takeaway. Customer details are optional for counter orders.</p>
@if (failure is not null) { <div class="alert alert-danger" role="alert">@failure</div> }
@if (loading) { <p role="status">Loading counter menu…</p> }
else if (saved is not null)
{
    <div class="alert alert-success" role="status"><h2 class="h4">Order saved</h2><p class="text-break">@saved.Reference</p><a class="btn btn-primary" href="@($"/pos/orders/{saved.Id}")">Open order &amp; bill</a><a href="/pos/orders/new" data-enhance-nav="false" class="btn btn-outline-secondary ms-2">Start another order</a></div>
}
else if (catalog is not null)
{
    <form @onsubmit="NoSubmit" @onsubmit:preventDefault="true" data-order-write="true">
    <fieldset disabled="@(busy || frozen)"><legend class="visually-hidden">Walk-in details and products</legend>
    <div class="row g-3 mb-4">
        <div class="col-md-6"><label for="counter-type" class="form-label">Fulfillment</label><select id="counter-type" class="form-select" @bind="mode" @bind:after="Changed"><option value="Pickup">Takeaway</option><option value="DineIn">Dine-in</option></select></div>
        @if (mode == "DineIn") { <div class="col-md-6"><label for="counter-table" class="form-label">Existing table</label><select id="counter-table" class="form-select" @bind="tableCode" @bind:after="Changed"><option value="">Choose a table</option>@foreach (var table in tables) { <option value="@table.PublicCode.ToString()">@table.Label</option> }</select></div> }
        <div class="col-md-6"><label for="counter-name" class="form-label">Name (optional)</label><input id="counter-name" class="form-control" maxlength="120" autocomplete="off" @bind="name" @bind:after="Changed" /></div>
        <div class="col-md-6"><label for="counter-phone" class="form-label">Phone (optional)</label><input id="counter-phone" type="tel" class="form-control" maxlength="40" autocomplete="off" @bind="phone" @bind:after="Changed" /></div>
    </div>
    <div class="row g-4"><section class="col-lg-7"><h2 class="h4">Menu</h2>
    @foreach (var category in catalog.Categories)
    {
        <h3 class="h5 mt-3 text-break">@category.Name</h3>
        @if (category.Products.Length == 0) { <p class="text-secondary">No available products.</p> }
        @foreach (var product in category.Products) { <div class="card card-body mb-2"><div class="d-flex flex-wrap align-items-center justify-content-between gap-2"><div><strong class="text-break">@product.Name</strong><div>@product.Price.ToString("F2") EGP</div></div><button type="button" class="btn btn-outline-primary" @onclick="() => Add(product)" aria-label="@($"Add {product.Name} ({product.Id})")">Add</button></div></div> }
    }
    </section><section class="col-lg-5"><div class="card card-body"><h2 class="h4">Counter cart</h2>
        @if (cart.Count == 0) { <p>No items selected.</p> }
        @foreach (var item in cart.Values.OrderBy(i => i.Product.Id))
        {
            <div class="border-bottom py-3" @key="item.Product.Id"><strong class="text-break">@item.Product.Name</strong><label class="form-label d-block mt-2" for="@($"qty-{item.Product.Id}")">Quantity</label><div class="d-flex flex-wrap gap-2"><input id="@($"qty-{item.Product.Id}")" type="number" min="1" class="form-control" style="width:7rem" value="@item.Quantity" @onchange="e => Quantity(item.Product.Id, e.Value?.ToString())" /><button type="button" class="btn btn-outline-danger" @onclick="() => Remove(item.Product.Id)">Remove</button></div></div>
        }
        <p class="small text-secondary mt-3">Review current prices before saving. Reloading or leaving loses this draft. If the outcome is uncertain, keep this page and retry the unchanged attempt.</p>
        <button type="button" class="btn btn-primary" disabled="@(cart.Count == 0 || invalidQuantity)" @onclick="Review">Review current prices</button>
    </div></section></div>
    </fieldset>
    @if (review is not null)
    {
        <section class="card card-body mt-4"><h2 class="h4">Confirm order</h2><p>@(review.OrderType == "DineIn" ? $"Table {review.Table?.Label}" : "Takeaway")</p>
            <ul class="list-group list-group-flush">@foreach (var item in review.Items) { <li class="list-group-item text-break">@item.ProductName · @item.Quantity × @item.UnitPrice = @item.LineTotal EGP</li> }</ul>
            <strong class="fs-4 my-3">Total @review.Total EGP</strong><p>Saving places this order with the displayed prices.</p>
            <div class="d-flex flex-wrap gap-2"><button type="button" class="btn btn-primary" disabled="@busy" @onclick="Place">@(busy ? "Saving…" : frozen ? "Retry unchanged attempt" : "Confirm & save order")</button>@if (!frozen) { <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="CancelReview">Edit order</button> }</div>
        </section>
    }
    </form>
}

@if (leaveTarget is not null)
{
    <div class="modal d-block" role="dialog" aria-modal="true" aria-labelledby="leave-heading" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 id="leave-heading" class="modal-title h5">Leave this draft?</h2></div><div class="modal-body"><p>@(frozen ? "This order may already be saved. Leaving loses the unchanged retry context." : "Leaving clears your unsaved counter draft.")</p></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" @ref="stayButton" @onclick="Stay">Stay</button><button type="button" class="btn btn-danger" @onclick="Leave">Leave draft</button></div></div></div></div><div class="modal-backdrop show"></div>
}
@code {
    private PickupMenuDetails? catalog;
    private PosTable[] tables = [];
    private readonly Dictionary<int, Selection> cart = [];
    private readonly string attempt = Convert.ToBase64String(RandomNumberGenerator.GetBytes(32)).TrimEnd('=').Replace('+', '-').Replace('/', '_');
    private string mode = "Pickup", tableCode = "", name = "", phone = "";
    private string? failure;
    private bool loading = true, busy, frozen;
    private readonly HashSet<int> invalidQuantities = [];
    private bool invalidQuantity => invalidQuantities.Count > 0;
    private OrderReview? review;
    private CounterOrderInput? submission;
    private CounterPlacement? saved;
    private IJSObjectReference? navigationGuard;
    private DotNetObjectReference<NewOrder>? guardCallback;
    private string? leaveTarget;
    private ElementReference stayButton;
    private bool focusLeave;
    private bool disposed;
    private readonly string guardId = Guid.NewGuid().ToString("N");
    private sealed record Selection(PublicMenuProduct Product, int Quantity);
    protected override async Task OnInitializedAsync()
    {
        try { var principal = (await Authentication.GetAuthenticationStateAsync()).User; var menu = await Pos.CatalogAsync(principal); var tableList = await Pos.TablesAsync(principal); if (menu.Error is not null || tableList.Error is not null) failure = menu.Error?.Message ?? tableList.Error?.Message; else { catalog = menu.Value; tables = tableList.Value!; } }
        finally { loading = false; }
    }
    private void NoSubmit() { }
    private void Changed() { if (busy || frozen) return; review = null; submission = null; if (!invalidQuantity) failure = null; }
    private void CancelReview() { if (!busy && !frozen) { review = null; submission = null; } }
    private void Add(PublicMenuProduct product) { if (busy || frozen) return; var quantity = cart.TryGetValue(product.Id, out var existing) ? existing.Quantity : 0; if (quantity == int.MaxValue) { failure = "Quantity exceeds supported range."; return; } cart[product.Id] = new(product, quantity + 1); Changed(); }
    private void Remove(int id) { if (busy || frozen) return; cart.Remove(id); invalidQuantities.Remove(id); Changed(); }
    private void Quantity(int id, string? value) { if (busy || frozen) return; if (!int.TryParse(value, out var quantity) || quantity <= 0) { invalidQuantities.Add(id); failure = "Enter a positive whole quantity or remove the item."; review = null; return; } cart[id] = cart[id] with { Quantity = quantity }; invalidQuantities.Remove(id); Changed(); }
    private CounterOrderInput Draft() => new() { AttemptKey = attempt, OrderType = mode, TablePublicCode = mode == "DineIn" && Guid.TryParse(tableCode, out var code) ? code : null, CustomerName = name, CustomerPhone = phone, Items = cart.Values.Select(i => new OrderDraftItem { ProductId = i.Product.Id, Quantity = i.Quantity }).ToArray() };
    private async Task Review()
    {
        if (busy || frozen || invalidQuantity) return; busy = true; failure = null; review = null;
        try { submission = Draft(); var result = await Pos.ReviewAsync((await Authentication.GetAuthenticationStateAsync()).User, submission); if (result.Error is not null) failure = result.Error.Message; else { review = result.Value; submission.ReviewedPrices = review!.Items.Select(i => new ReviewedPrice { ProductId = i.ProductId, UnitPrice = i.UnitPrice }).ToArray(); } }
        finally { busy = false; }
    }
    private async Task Place()
    {
        if (busy || submission is null || review is null) return; busy = true; failure = null;
        try
        {
            var result = await Pos.PlaceAsync((await Authentication.GetAuthenticationStateAsync()).User, submission);
            if (result.Error is null) { saved = result.Value; frozen = false; cart.Clear(); }
            else { failure = result.Error.Message; frozen = result.Error.Kind == OperationErrorKind.Unexpected; if (result.Review is not null) { review = result.Review; submission.ReviewedPrices = review.Items.Select(i => new ReviewedPrice { ProductId = i.ProductId, UnitPrice = i.UnitPrice }).ToArray(); } }
        }
        catch { frozen = true; failure = "The outcome is uncertain. Keep this page and retry the unchanged attempt."; }
        finally { busy = false; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (disposed) return;
            if (focusLeave) { focusLeave = false; await stayButton.FocusAsync(); }
            guardCallback ??= DotNetObjectReference.Create(this);
            navigationGuard ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/pos-navigation.js");
            if (disposed) return;
            await navigationGuard.InvokeVoidAsync("update", guardId, cart.Count > 0 && saved is null, busy, guardCallback);
        }
        catch (JSDisconnectedException) { }
    }
    [JSInvokable] public Task RequestLeave(string target) => InvokeAsync(() => { if (!busy && !disposed) { leaveTarget = target; focusLeave = true; StateHasChanged(); } });
    private void Stay() => leaveTarget = null;
    private async Task Leave() { if (leaveTarget is not null && navigationGuard is not null) await navigationGuard.InvokeVoidAsync("leave", guardId, leaveTarget); }
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        guardCallback?.Dispose();
        if (navigationGuard is null) return;
        try { await navigationGuard.InvokeVoidAsync("remove", guardId); await navigationGuard.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
