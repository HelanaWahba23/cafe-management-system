@inject NavigationManager Navigation
<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData">
            <NotAuthorized Context="authentication">
                <main class="container py-4">
                    @if (authentication.User.Identity?.IsAuthenticated == true)
                    {
                        <h1>Access denied</h1>
                        <p>The required staff role is needed to open this page.</p>
                    }
                    else
                    {
                        <h1>Sign in required</h1>
                        <a href="@(new Uri(Navigation.Uri).AbsolutePath.StartsWith("/customer") ? "/customer/login" : "/account/login")" data-enhance-nav="false">Sign in</a>
                    }
                </main>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <main class="container py-4"><h1>Page not found</h1></main>
    </NotFound>
</Router>
