<section class="order-progress" aria-label="Order progress"><ol>@foreach(var step in Steps){<li class="@(Position(step)<=Position(Status)?"is-complete":"")"><span aria-hidden="true">@(Position(step)<Position(Status)?"✓":(Position(step)+1).ToString())</span>@Label(step,OrderType)</li>}</ol>@if(Status=="Rejected"){<p class="alert alert-warning">This order was rejected. See the reason below.</p>}</section>
@code{[Parameter]public string Status{get;set;}="Submitted";[Parameter]public string OrderType{get;set;}="Pickup";string[] Steps=>OrderType=="Delivery"?["Submitted","Accepted","Preparing","Ready","OutForDelivery","Completed"]:["Submitted","Accepted","Preparing","Ready","Completed"];int Position(string value)=>Array.IndexOf(Steps,value);public static string Label(string status,string type)=>status switch{"Submitted"=>"Pending","OutForDelivery"=>"Out for delivery","Completed"=>type=="Delivery"?"Delivered":"Completed",_=>status};}
