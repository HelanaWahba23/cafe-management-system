<div id="components-reconnect-modal" class="components-reconnect-hide" role="alertdialog"
     aria-modal="true" aria-labelledby="reconnect-title" aria-describedby="reconnect-help" tabindex="-1">
    <div class="card shadow p-4">
        <h2 id="reconnect-title" class="h4">Connection interrupted</h2>
        <p id="reconnect-state" role="status">Reconnecting…</p>
        <p id="reconnect-help">Editing is paused. Reload saved data before trying again.
            A pending save may have completed; check the record before submitting it again.
            Unsaved text may be lost on reload.</p>
        <button id="reconnect-reload" type="button" class="btn btn-primary">Reload saved data</button>
    </div>
</div>
