@page "/customer/login"
@model CafeManagement.Api.Pages.Customer.LoginModel
@{Layout="/Pages/Shared/_CustomerLayout.cshtml";ViewData["Title"]="Login";}
<section class="customer-auth card card-body"><p class="eyebrow">Welcome back</p><h1>A seat with your name on it.</h1><form method="post"><input type="hidden" asp-for="ReturnUrl"/><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="mb-3"><label asp-for="Input.Email">Email</label><input asp-for="Input.Email" class="form-control" autocomplete="username"/></div><div class="mb-3"><label asp-for="Input.Password">Password</label><input asp-for="Input.Password" class="form-control" autocomplete="current-password"/></div><button class="btn btn-primary" type="submit">Login</button></form><p class="mt-3">New here? <a href="/customer/register">Create an account</a></p><a href="/account/login">Staff sign in</a></section>
