@page "/customer/register"
@model CafeManagement.Api.Pages.Customer.RegisterModel
@{Layout="/Pages/Shared/_CustomerLayout.cshtml";ViewData["Title"]="Create account";}
<section class="customer-auth card card-body"><p class="eyebrow">Your table is waiting</p><h1>Join Café</h1><p>Save your details and keep your orders together.</p><form method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="mb-3"><label asp-for="Input.DisplayName">Full name</label><input asp-for="Input.DisplayName" class="form-control" autocomplete="name"/></div><div class="mb-3"><label asp-for="Input.Email">Email</label><input asp-for="Input.Email" class="form-control" autocomplete="email"/></div><div class="mb-3"><label asp-for="Input.Phone">Phone</label><input asp-for="Input.Phone" class="form-control" autocomplete="tel"/></div><div class="mb-3"><label asp-for="Input.Password">Password</label><input asp-for="Input.Password" class="form-control" autocomplete="new-password"/><small>At least8 characters, with uppercase, lowercase, a number and a symbol.</small></div><div class="mb-3"><label asp-for="Input.ConfirmPassword">Confirm password</label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password"/></div><button class="btn btn-primary" type="submit">Create account</button></form><p class="mt-3">Already a member? <a href="/customer/login">Login</a></p></section>
