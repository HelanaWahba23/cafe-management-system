+    private async Task StartOnline()
+    {
+        if (busy || Capability is null || StaffOrderId is not null || status?.State != "Unpaid" || !status.OnlineAvailable) return;
+        var key = Capability; var current = version; busy = true; failure = null;
+        try
+        {
+            var result = await Online.StartAsync(key);
+            if (disposed || current != version) return;
+            failure = result.Error?.Message; checkoutUrl = result.CheckoutUrl;
+            if (result.Status is not null) status = result.Status;
+            else if (result.Error is not null)
+            {
+                // An interrupted POST may already have saved a blocking attempt.
+                var refreshed = await Payments.GetGuestAsync(key);
+                if (disposed || current != version) return;
+                status = refreshed.Value;
+            }
+        }
+        finally { if (!disposed && current == version) busy = false; }
+    }
+    private async Task Reconcile()
+    {
+        if (busy) return; var current = version; var id = StaffOrderId; var key = Capability; busy = true; failure = null;
+        try
+        {
+            if (id is not null)
+            {
+                var error = await Online.ReconcileStaffAsync((await Authentication.GetAuthenticationStateAsync()).User, id.Value);
+                if (disposed || current != version) return;
+                failure = error?.Message;
+                if (error is null) await OnPaymentChanged.InvokeAsync();
+            }
+            else if (key is not null)
+            {
+                var result = await Online.ReconcileGuestAsync(key);
+                if (disposed || current != version) return;
+                failure = result.Error?.Message;
+                if (result.Status is not null) status = result.Status;
+                if (status?.State is "PaidCash" or "PaidSandbox") checkoutUrl = null;
+            }
+        }
+        finally { if (!disposed && current == version) busy = false; }
+    }
     public void Dispose() { disposed = true; ++version; }
 }
diff --git a/CafeManagement.Api/Controllers/PaymentsController.cs b/CafeManagement.Api/Controllers/PaymentsController.cs
index ba7d896..b7a7b1d 100644
--- a/CafeManagement.Api/Controllers/PaymentsController.cs
+++ b/CafeManagement.Api/Controllers/PaymentsController.cs
@@ -8,8 +8,42 @@ namespace CafeManagement.Api.Controllers;
 
 [ApiController]
 [ResponseCache(NoStore = true, Location = ResponseCacheLocation.None)]
-public sealed class PaymentsController(PaymentService payments) : ControllerBase
+public sealed class PaymentsController(PaymentService payments, PaymobPaymentService online) : ControllerBase
 {
+    [AllowAnonymous]
+    [EnableRateLimiting("GuestOrders")]
+    [HttpPost("api/orders/payment/start")]
+    [Consumes("application/json")]
+    [ValidateAntiForgeryToken]
+    public async Task<IActionResult> Start(PaymentActionInput input, CancellationToken ct)
+    {
+        var result = await online.StartAsync(Capability(), ct);
+        return result.Error is null ? Ok(new { result.Status, result.CheckoutUrl }) : ApiErrors.ToResult(result.Error);
+    }
+
+    [AllowAnonymous]
+    [EnableRateLimiting("GuestOrders")]
+    [HttpPost("api/orders/payment/reconcile")]
+    [Consumes("application/json")]
+    [ValidateAntiForgeryToken]
+    public async Task<IActionResult> Reconcile(PaymentActionInput input, CancellationToken ct)
+    {
+        var result = await online.ReconcileGuestAsync(Capability(), ct);
+        return result.Error is null ? Ok(result.Status) : ApiErrors.ToResult(result.Error);
+    }
+
+    [Authorize(Policy = "Cashier")]
+    [HttpPost("api/pos/orders/{id:long}/payment/reconcile")]
+    [Consumes("application/json")]
+    [ValidateAntiForgeryToken]
+    public async Task<IActionResult> ReconcileStaff(long id, PaymentActionInput input, CancellationToken ct)
+    {
+        var error = await online.ReconcileStaffAsync(User, id, ct);
+        if (error is not null) return ApiErrors.ToResult(error);
+        var result = await payments.GetStaffAsync(User, id, ct);
+        return result.Error is null ? Ok(result.Value) : ApiErrors.ToResult(result.Error);
+    }
+
     [Authorize(Policy = "Cashier")]
     [HttpGet("api/pos/orders/{id:long}/payment")]
     public async Task<IActionResult> StaffStatus(long id, CancellationToken ct)
